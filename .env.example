# Copie este arquivo para ".env" e ajuste conforme o ambiente.
# O arquivo ".env" NÃO deve ser versionado (já está no .gitignore).

# Caminho do banco SQLite (fica fora do controle de versão).
PRINT_MONITOR_DB=data/print_monitor.db

# Backend de coleta padrão: "snmp" para impressoras reais ou "mock" para testes.
PRINT_MONITOR_BACKEND=snmp
# Numero de consultas simultaneas durante a coleta em lote (1-128).
PRINT_MONITOR_WORKERS=8

# --- Parâmetros SNMP ---
# Community string de leitura. Use valor ficticio em exemplos.
SNMP_COMMUNITY=public
# Versao do protocolo: "2c" (padrao) ou "1" para equipamentos antigos.
SNMP_VERSION=2c
SNMP_PORT=161
# Timeout (segundos, aceita decimal) e numero de tentativas por leitura.
SNMP_TIMEOUT=2
SNMP_RETRIES=1
